{
  "name": "whatsapp-kalender",
  "version": "0.1.0",
  "private": true,
  "description": "Terminassistent: WhatsApp-Nachrichten teilen, Termine deterministisch erkennen, in CalDAV speichern und erinnern",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "chrono-node": "^2.10.2",
    "fastify": "^5.12.5",
    "ical.js": "^2.2.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.15",
    "tsdav": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

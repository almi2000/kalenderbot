# Zeitzone für Parser, Kalender und Erinnerungen
TZ=Europe/Berlin

# Adresse, unter der die Web-App erreichbar ist (Tailscale-HTTPS-Name des Pi)
PUBLIC_URL=https://raspberrypi.example-tailnet.ts.net

# Zugangstoken für die Web-App. Einmalig https://<PUBLIC_URL>/login?token=<APP_TOKEN> öffnen.
# Erzeugen z. B. mit: openssl rand -hex 24
APP_TOKEN=bitte-aendern

# Zugang zu Radicale (muss in radicale/users angelegt sein)
CALDAV_USER=ich
CALDAV_PASSWORD=bitte-aendern
# URL-Pfad und Anzeigename des Kalenders; wird beim ersten Start automatisch angelegt
CALDAV_CALENDAR=termine
CALDAV_CALENDAR_NAME=Termine

# Termindauer, wenn in der Nachricht keine Endzeit steht
DEFAULT_DURATION_MINUTES=60
# Erinnerung auf dem Handy (VALARM, über DAVx5) in Minuten vor Terminbeginn
PHONE_ALARM_MINUTES=30

# E-Mail/Push-Erinnerungen für wichtige Termine: Minuten vorher, kommagetrennt (1440 = 1 Tag)
REMINDER_OFFSETS_MINUTES=1440,60
# Bei Ganztagsterminen wird ab dieser Uhrzeit gerechnet (z. B. "1 Stunde vorher" = 07:00)
ALLDAY_REMINDER_TIME=08:00
# Wie oft nach fälligen Erinnerungen gesucht wird
REMINDER_CRON=*/5 * * * *

# SMTP für E-Mail-Erinnerungen (leer lassen = keine E-Mails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true für Port 465 (implizites TLS), false für STARTTLS auf 587
SMTP_SECURE=false
SMTP_USER=kalender@example.com
SMTP_PASSWORD=bitte-aendern
MAIL_FROM=Kalender-Bot <kalender@example.com>
MAIL_TO=ich@example.com

# Optional: Push über ntfy (docker compose --profile ntfy up -d)
# NTFY_URL=http://ntfy
# NTFY_TOPIC=termine-zufaelliger-name
# NTFY_TOKEN=
# Öffentliche ntfy-Adresse für die Android-App
# NTFY_PUBLIC_URL=https://raspberrypi.example-tailnet.ts.net:10000
